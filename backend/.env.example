# MiniHES Backend Environment

# Application
PROJECT_NAME=MiniHES
API_V1_PREFIX=/api/v1
DEBUG=true
CORS_ORIGINS=["http://localhost:5666","http://localhost:5173","http://localhost:5320"]

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://minihes:minihes@localhost:5432/minihes
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-token
INFLUXDB_ORG=metering
INFLUXDB_BUCKET=metering

# JWT
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Collector
COLLECTOR_MAX_WORKERS=10
COLLECTOR_DEFAULT_TIMEOUT=30
COLLECTOR_RETRY_TIMES=3
